# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio.

# --- MySQL (usado por docker-compose.yml y seeder.py) ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=pirotecniaprometeo

# --- Conexión desde seeder.py (fuera de Docker) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Metabase: clave para cifrar en reposo la contraseña de MySQL guardada ---
# Debe ser EXACTAMENTE la misma que usan los demás miembros del equipo,
# si no Metabase no podrá leer la conexión ya guardada. Pídesela a tu compañero.
MB_ENCRYPTION_SECRET_KEY=changeme-min-16-caracteres
